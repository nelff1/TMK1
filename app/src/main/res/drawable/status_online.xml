<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Заливка: зелёный цвет для "онлайн" -->
    <solid android:color="#4CAF50"/>

    <!-- Обводка: белая для контраста -->
    <stroke
        android:width="2dp"
        android:color="#FFFFFF"/>

    <!-- Размер круга -->
    <size
        android:width="16dp"
        android:height="16dp"/>
</shape>
