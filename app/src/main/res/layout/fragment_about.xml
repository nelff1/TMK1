<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/about_image"
        android:layout_width="411dp"
        android:layout_height="182dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="Logo"
        android:scaleType="centerCrop"
        android:src="@drawable/logo2" />

    <TextView
        android:id="@+id/about_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ТМК Центр Бизнес-услуг"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/about_description"
        android:layout_width="match_parent"
        android:layout_height="98dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:lineSpacingExtra="8dp"
        android:text="ТМК ЦБУ — это дочернее предприятие Трубной Металлургической Компании, \nкоторое является центром, оказывающим сервисные услуги для предприятий по различным направлениям"
        android:textColor="@android:color/holo_orange_dark"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/about_services_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Мы предоставляем услуги по:"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/about_services"
        android:layout_width="wrap_content"
        android:layout_height="127dp"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="◍ Бухгалтерский учёт и отчётность\n◍ Финансовое и документальное сопровождение коммерческой деятельности\n◍ Сопровождение сервисов управления персоналом\n◍ Юридическое сопровождение"
        android:textColor="@android:color/black"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-40dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/contact_us_button"
            android:contentDescription="Кнопка звонка"
            android:layout_width="38dp"
            android:layout_height="45dp"
            android:layout_margin="16dp"
            android:elevation="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="25dp"
            app:icon="@android:drawable/ic_menu_call"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@android:color/white" />
    </LinearLayout>

</LinearLayout>