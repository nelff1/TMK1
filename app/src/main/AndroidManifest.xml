<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Разрешения для доступа к хранилищу -->
    <!-- Для Android 10 и ниже -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Для Android 11-12 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Для Android 13+ (новое API) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33" />

    <!-- Для работы с интернетом -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/logo_foreground"
        android:roundIcon="@mipmap/logo_foreground"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TMK"
        android:requestLegacyExternalStorage="true">

        <!-- FileProvider для безопасной работы с файлами -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Экран входа - точка входа в приложение -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Главное активити с вкладками -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <!-- Личный кабинет -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <!-- Детальная страница объявления/мероприятия -->
        <activity
            android:name=".activities.AnnouncementActivity"
            android:exported="false" />

    </application>

</manifest>